{
  "name": "pebloy",
  "version": "2.0.0",
  "description": "SQL Server schema diff, backup, and deployment tool for Windows — compare, script, and deploy database objects.",
  "main": "src/electron/main.js",
  "author": "Pebloy Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshaDidSmtg/Pebloy.git"
  },
  "bugs": {
    "url": "https://github.com/HarshaDidSmtg/Pebloy/issues"
  },
  "homepage": "https://github.com/HarshaDidSmtg/Pebloy#readme",
  "keywords": [
    "sql-server",
    "database",
    "schema-diff",
    "deployment",
    "powershell",
    "electron"
  ],
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "qs": "6.16.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "prepare:resources": "node scripts/prepare-resources.js",
    "prebuild": "npm run prepare:resources",
    "prebuild:dir": "npm run prepare:resources",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "check": "node scripts/check-js.js",
    "test": "jest",
    "test:browser": "playwright test --project=desktop --project=mobile",
    "test:desktop": "playwright test --project=packaged"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "express": "^4.22.2",
    "highlight.js": "^11.12.0",
    "monaco-editor": "^0.52.2",
    "poor-mans-t-sql-formatter": "^1.6.10",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.pebloy.app",
    "productName": "Pebloy",
    "copyright": "Copyright © 2025 Pebloy Contributors",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "public/**/*",
      "scripts/powershell/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/dacfx-worker/win-x64",
        "to": "dacfx-worker"
      },
      {
        "from": "vendor/ps-modules/SqlServer/22.4.5.1",
        "to": "vendor/ps-modules/SqlServer/22.4.5.1"
      },
      {
        "from": "scripts/powershell/CompareTablesGenerateDelta.ps1",
        "to": "scripts/powershell/CompareTablesGenerateDelta.ps1"
      },
      {
        "from": "scripts/powershell/DBObjectsBulkScriptGenerator.ps1",
        "to": "scripts/powershell/DBObjectsBulkScriptGenerator.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "Pebloy-Setup.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pebloy"
    },
    "portable": {
      "artifactName": "Pebloy-${version}-portable.exe"
    }
  }
}

{
  "name": "pebloy",
  "version": "1.3.2",
  "description": "SQL Server schema diff, backup, and deployment tool for Windows — compare, script, and deploy database objects.",
  "main": "src/electron/main.js",
  "author": "Pebloy Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshaDidSmtg/Pebloy.git"
  },
  "bugs": {
    "url": "https://github.com/HarshaDidSmtg/Pebloy/issues"
  },
  "homepage": "https://github.com/HarshaDidSmtg/Pebloy#readme",
  "keywords": [
    "sql-server",
    "database",
    "schema-diff",
    "deployment",
    "powershell",
    "electron"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "electron": "electron .",
    "electron:dev": "electron . --dev",
    "prebuild": "node scripts/prebuild-win.js",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir",
    "check": "node --check src/server.js && node --check src/services/backupService.js && node --check src/services/deploymentService.js && node --check src/services/diffService.js && node --check src/services/loggingService.js && node --check src/services/profileService.js && node --check src/services/scriptAutomationService.js && node --check src/services/secretStore.js && node --check src/services/sqlService.js && node --check src/services/storage.js && node --check src/services/systemService.js && node --check src/electron/main.js && node --check public/app.js",
    "test": "jest"
  },
  "dependencies": {
    "diff": "^5.2.0",
    "express": "^4.19.2",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.pebloy.app",
    "productName": "Pebloy",
    "copyright": "Copyright © 2025 Pebloy Contributors",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "scripts/powershell/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/powershell/CompareTablesGenerateDelta.ps1",
        "to": "scripts/powershell/CompareTablesGenerateDelta.ps1"
      },
      {
        "from": "scripts/powershell/DBObjectsBulkScriptGenerator.ps1",
        "to": "scripts/powershell/DBObjectsBulkScriptGenerator.ps1"
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico",
      "sign": null,
      "signingHashAlgorithms": null,
      "certificateSubjectName": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pebloy"
    },
    "portable": {
      "artifactName": "Pebloy-${version}-portable.exe"
    }
  }
}
